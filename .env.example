# ── LLM (Groq) ────────────────────────────────────────────
# Get free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Gmail Alerts ──────────────────────────────────────────
# Enable 2-Step Verification in Gmail then create App Password:
# Gmail -> Settings -> Security -> App Passwords -> Generate
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_RECIPIENT=recipient@gmail.com

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/videogpt.db

# ── Processing Settings ───────────────────────────────────
FRAME_SKIP=5
CONFIDENCE_THRESHOLD=0.45

# ── App ───────────────────────────────────────────────────
APP_NAME=VideoGPT
